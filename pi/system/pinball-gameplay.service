[Unit]
Description=Pinball: the game (TypeScript brain, drives the Mega over USB)
After=network.target
StartLimitIntervalSec=0

[Service]
User=pi
WorkingDirectory=/home/pi/PinballMachine/Gameplay
ExecStart=/usr/bin/node dist/main.js
# The web page on port 80. Without this it uses 8080.
Environment=PINBALL_HTTP_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
